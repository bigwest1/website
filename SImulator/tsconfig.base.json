{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@course-creator-os/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@course-creator-os/core-types": ["packages/core-types/src/index.ts"],
      "@course-creator-os/ui": ["packages/ui/src/index.ts"],
      "@course-creator-os/course-bible": ["packages/course-bible/src/index.ts"],
      "@course-creator-os/hole-planner": ["packages/hole-planner/src/index.ts"],
      "@course-creator-os/asset-system": ["packages/asset-system/src/index.ts"],
      "@course-creator-os/world-system": ["packages/world-system/src/index.ts"],
      "@course-creator-os/event-system": ["packages/event-system/src/index.ts"],
      "@course-creator-os/project-model": ["packages/project-model/src/index.ts"],
      "@course-creator-os/scene-authoring": ["packages/scene-authoring/src/index.ts"],
      "@course-creator-os/validation": ["packages/validation/src/index.ts"],
      "@course-creator-os/performance": ["packages/performance/src/index.ts"],
      "@course-creator-os/sim-logic": ["packages/sim-logic/src/index.ts"],
      "@course-creator-os/integration": ["packages/integration/src/index.ts"],
      "@course-creator-os/preview": ["packages/preview/src/index.ts"],
      "@course-creator-os/packaging": ["packages/packaging/src/index.ts"],
      "@course-creator-os/versioning": ["packages/versioning/src/index.ts"],
      "@course-creator-os/agent-system": ["packages/agent-system/src/index.ts"],
      "@course-creator-os/storage": ["packages/storage/src/index.ts"],
      "@course-creator-os/logging": ["packages/logging/src/index.ts"],
      "@course-creator-os/config": ["packages/config/src/index.ts"],
      "@course-creator-os/utils": ["packages/utils/src/index.ts"]
    }
  }
}
